# Test the subbit-issuer native CLI against a real server with curl.
#
#   just init             # write starter settings.toml
#   just show             # print current (redacted) settings
#   just get /some/path   # spend -> curl GET -> response, in one shot
#   just post /path -d '{"foo":"bar"}'   # same, but POST
#   just get /path -v     # extra args are forwarded straight to curl
#
# `_fetch` builds a spend envelope for PATH, attaches it as the `subbit`
# request header, hits `$server_url$path` with METHOD, and if the reply
# carries a `subbit` response header, feeds it back to `cli response` so
# the local cache (spent/committed/mac) stays in sync for the next call.
bin    := "cargo run --quiet --bin subbit-issuer --"
settings := "settings.toml"
default:
    just --list
init:
    {{bin}} --settings {{settings}} init
show:
    {{bin}} --settings {{settings}} show
get path *curl_args:
    @just _fetch GET {{path}} {{curl_args}}
post path *curl_args:
    @just _fetch POST {{path}} {{curl_args}}
_fetch method path *curl_args:
    #!/usr/bin/env bash
    set -euo pipefail
    server=$(grep -E '^server_url' {{settings}} | sed -E 's/server_url *= *"(.*)"/\1/')
    envelope=$({{bin}} --settings {{settings}} spend {{path}})
    body=$(mktemp)
    trap 'rm -f "$body"' EXIT
    headers=$(curl -sS -D - -o "$body" \
        -X {{method}} \
        -H "subbit: $envelope" \
        {{curl_args}} \
        "$server{{path}}")
    reply=$(printf '%s' "$headers" \
        | grep -i '^subbit:' | head -n1 \
        | sed -E 's/^[Ss]ubbit: *//' | tr -d '\r')
    if [ -n "$reply" ]; then
        {{bin}} --settings {{settings}} response "$reply"
    else
        echo "warning: no subbit response header in reply" >&2
    fi
    cat "$body"
